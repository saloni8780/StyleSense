# ============================================================
#  StyleSense — environment variables
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env to Git.
# ============================================================

# ── Google AI Studio (FREE image generation — 500 images/day) ──
# Get key at: https://aistudio.google.com/apikey  (no credit card)
GOOGLE_AI_STUDIO_KEY=

# ── Groq (FREE text LLM — styling advice) ───────────────────
# Get key at: https://console.groq.com  (no credit card)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Vertex AI (Gemini Vision — lookbook feedback) ────
# Requires a GCP project with Vertex AI enabled.
# For free-tier testing, use the AI Studio key above instead.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
VERTEX_MODEL=gemini-2.0-flash

# ── Cloudinary (FREE image storage — 25 GB) ──────────────────
# Get keys at: https://cloudinary.com  (free account, no card)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-something-random-50-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL (local dev) ────────────────────────────────────
# On Render, DATABASE_URL is set automatically — don't set it locally.
DB_NAME=stylesense
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── CORS ─────────────────────────────────────────────────────
# Add your Vercel frontend URL here when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite reads VITE_ prefixed vars) ────────────────
# These go in frontend/.env  (see frontend/.env.example)
VITE_AI_API_BASE=http://localhost:8001
VITE_DJANGO_API_BASE=http://localhost:8000
