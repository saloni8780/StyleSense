# Copy this to frontend/.env for local development.
# On Vercel, add these as Environment Variables in the project dashboard.

# URL of your FastAPI ai_service
# Local:  http://localhost:8001
# Render: https://stylesense-ai.onrender.com  (replace with your actual Render URL)
VITE_AI_API_BASE=http://localhost:8001

# URL of your Django backend
# Local:  http://localhost:8005
# Render: https://stylesense-django.onrender.com  (replace with your actual Render URL)
VITE_DJANGO_API_BASE=http://localhost:8005
